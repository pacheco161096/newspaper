{
  "name": "hola-vallarta",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:production": "node --env-file=.env.production.local scripts/migrate.mjs",
    "cms:hash-password": "node scripts/hash-password.mjs",
    "telegram:check": "node --experimental-strip-types scripts/check-telegram.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "@vercel/functions": "^3.9.9",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.1",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
