{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Categoría",
    "description": "Secciones editoriales de Hola Vallarta"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true, "maxLength": 80 },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "description": { "type": "text" },
    "color": { "type": "string", "default": "#F22F50", "maxLength": 9 },
    "navigationOrder": { "type": "integer", "default": 0, "min": 0 },
    "articles": { "type": "relation", "relation": "oneToMany", "target": "api::article.article", "mappedBy": "category" }
  }
}
